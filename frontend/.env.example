NEXT_TELEMETRY_DISABLED=1

# InsureCare backend (backend/). The Next.js server reads from it and forwards the browser's /api calls to it,
# so the sign-in cookie stays on this site. Use the backend's private address here (e.g. http://backend:8080 in Docker).
API_URL=http://localhost:8080
# Live-updates WebSocket, opened by the browser (with a one-time ticket, so it may be on another site, e.g. wss://<backend>/live).
# Default: port 8080 of the address the page was opened with.
# NEXT_PUBLIC_LIVE_URL=ws://localhost:8080/live

# The sign-in page lists the demo accounts (created by the backend with SEED_DATA). Set to false once real accounts exist.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
# NEXT_PUBLIC_DEMO_PASSWORD=insurecare
