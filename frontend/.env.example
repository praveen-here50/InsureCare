NEXT_TELEMETRY_DISABLED=1

# InsureCare backend (backend/). The browser calls it directly, so it must be reachable from the user's machine.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional: address the Next.js server uses for server-side reads (e.g. http://backend:8080 inside Docker).
# API_URL=http://localhost:8080
# Optional: live-updates WebSocket; defaults to NEXT_PUBLIC_API_URL with ws:// and /live.
# NEXT_PUBLIC_LIVE_URL=ws://localhost:8080/live

# Which hospital desk and member the portals show until sign-in exists.
# NEXT_PUBLIC_HOSPITAL_ID=riverbend
# NEXT_PUBLIC_MEMBER_ID=ic-7842
