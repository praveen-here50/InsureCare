# Read by docker compose. Copy to .env (never commit .env: it is in .gitignore).

# Free Groq key for Ask InsureCare, the patient assistant: https://console.groq.com/keys. Blank turns the assistant off.
GROQ_API_KEY=

# Browser origins allowed to sign in and open the live-updates socket. To use a phone on your Wi-Fi, add its network,
# e.g. http://192.168.*:3000 or http://10.*:3000 (* matches any part, so a changed Wi-Fi address keeps working).
ALLOWED_ORIGINS=http://localhost:3000

# Password of every demo account.
# DEMO_PASSWORD=insurecare
